      "params": {"level": 77, "atk": 80, "rel": 78, "CUT": 60, "lrate": 20, "ld_shp": 26, "ld_flt": 6,
                 "chor": 62, "dly": 16, "rev": 88}}},
    {"name": "bass", "role": "bass", "register": "A1", "sound": {"engine": "ANALOG", "preset": "SUB BASS",
      "params": {"level": 75, "atk": 64, "rel": 82, "rev": 6}}},
    {"name": "lead", "role": "lead", "register": "A3", "sound": {"engine": "ANALOG", "preset": "G-FUNK LD",
      "params": {"level": 75, "CUT": 106, "chor": 18, "dly": 56, "rev": 70, "pan": -6}}},
    {"name": "drums", "role": "drums", "sound": {"kit": "808", "params": {"level": 114, "rev": 56}}}
  ],
  "fx": {"dtime": "1/4", "dfdbk": 54, "dcolor": 48, "dmix": 92, "rsize": 116, "rdamp": 56, "crate": 26, "cdepth": 68},
  "patterns": {
    "pad_hold": {"track": "pad", "div": "1/4", "steps": "[c1 c5 c7 c3'] - - - | - - - -"},
    "pad_main": {"track": "pad", "div": "1/4", "steps": "[c1 c5 c7 c3'] - [c1 c5 c7 c9] -"},
    "pad_pulse": {"track": "pad", "div": "1/8", "steps": "[c1 c5 c7 c3'] - - [c1 c5 c7 c3']_ - - [c1 c5 c7 c9]_ -"},
    "pad_lift": {"track": "pad", "div": "1/8", "steps":
      "[c1 c5 c3' 5']! - - - [c1 c5 c3' 1''] - - - | [c1 c5 c3' 3'']! - - - [c1 c5 c3' 2''] - - - | [c1 c5 c3' 2'']! - - - [c1 c5 c3' 3''] - [c1 c5 c3' 5''] - | [c1 c5 c3' 4'']! - [c1 c5 c3' 3''] - [c1 c5 c3' 7'] - - -"},
    "bass_drone": {"track": "bass", "div": "1/4", "steps": "1 - - - - - - - - - - - - - - -"},
    "bass_pedal": {"track": "bass", "div": "1/4", "steps": "1 - - - - - - - - - - - 7, - - -"},
    "bass_pulse": {"track": "bass", "div": "1/8", "steps": "c1 - - c1 - - c1 -"},
    "dr_pulse": {"track": "drums", "lanes": {
      "kick":   "x..s............|x..s......s.....",
      "rim":    "........s.......|........s.......",
      "clap":   "........x.......|........x.......",
      "shaker": "s.x.s.ss..s.x.ss|s.x.s..ss.s.x.s."}},
    "dr_lift": {"track": "drums", "lanes": {
      "kick":   "x.....x...x.....|x.....x.......s.",
      "clap":   "........X.......|........X.......",
      "hat":    "..s...s...s...s.|..s...s...s.s.s.",
      "shaker": "s.sx..s.s.sx.s.s|s.sx..s.s.s.xss.",
      "open":   "................|..............g."}},
    "dr_fill": {"track": "drums", "lanes": {
      "kick":   "x.......x.......",
      "clap":   "........x.......",
      "shaker": "g.g.g.g.g.g.g.g.",
      "tomhi":  "..........g.s...",
      "tomlo":  "............s.sx"}}
  },
  "progressions": {
    "intro": ["i9:8", "VImaj7:8"],
    "main": ["i9:4", "VImaj7:4", "iv7:4", "VII:4"],
    "lift": ["VImaj7:4", "VIIsus4:2", "VII:2", "i9:4", "III:4"],
