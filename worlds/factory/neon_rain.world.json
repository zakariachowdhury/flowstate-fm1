  "rules": [
    {"if": {"SPACE": 0.75, "ENERGY": 0.75}, "then": [{"to": "bass.rev", "add": -6}, {"to": "g.drrev", "add": -24},
                                                     {"to": "g.dfdbk", "add": -22}, {"to": "*.level", "add": -5}]},
    {"if": {"COLOR": 0.75, "ENERGY": 0.75}, "then": [{"to": "pad.@RESO", "add": -8}, {"to": "lead.@RESO", "add": -4}]},
