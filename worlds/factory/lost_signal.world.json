      "params": {"level": 72, "atk": 96, "rel": 90, "BRTH": 40, "lwave": "S&H", "lrate": 26, "ld_flt": 10,
                 "chor": 64, "dly": 26, "rev": 92, "pan": -8}}},
    {"name": "beacon", "role": "texture", "register": "C4", "sound": {"engine": "LOFI", "preset": "GAME LEAD",
      "params": {"WAVE": "TRI", "VIB": 0, "TONE": 96, "level": 110, "dec": 60, "sus": 50, "rel": 60,
                 "dly": 76, "rev": 72, "pan": 14}}},
    {"name": "keys", "role": "keys", "register": "B2", "sound": {"engine": "DIGITAL", "preset": "WURLI",
