      "rim":    "........g.......|........g.......",
      "hat":    "..g...g...g...g.|..g...g...g.g.g."}},
    "dr_clear": {"track": "drums", "lanes": {
      "kick":   "x.........s.....|x...............",
      "rim":    "........g.......|........g.....g.",
      "hat":    "g.g.g.g.g.g.g.g.|g.g.g.g.g.g.g.gg",
      "open":   "..............s.|................"}},
    "dr_glitch": {"track": "drums", "lanes": {
      "kick":   "x...............",
      "hat":    "g.g.g.g.g.g.gggg",
      "rim":    "....g.......g...",
      "tomlo":  "..........g...s."}}
  },
  "progressions": {
    "static": ["i7:16"],
    "carrier": ["i7:8", "IV9:8"],
    "clear": ["III:8", "IV9:8", "VII:8", "i7:8"],
    "lost": ["VIIsus2:16", "i9:16"]
  },
  "scenes": {
