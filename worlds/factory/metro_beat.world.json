      "params": {"level": 104, "dec": 76, "sus": 60, "CUT": 78, "sgate": 66, "lrate": 40, "ld_flt": 8, "chor": 22, "dly": 40, "rev": 30, "pan": -8}}},
    {"name": "bass", "role": "bass", "register": "A1", "sound": {"engine": "PHASE", "preset": "CZ BASS",
      "params": {"level": 110, "sgate": 50, "rev": 4}}},
    {"name": "pluck", "role": "lead", "register": "C3", "sound": {"engine": "PHASE", "preset": "RESO PLUCK",
      "params": {"level": 106, "dly": 34, "rev": 30, "pan": 10}}},
    {"name": "drums", "role": "drums", "sound": {"kit": "TECHNO", "params": {"level": 60, "rev": 16}}}
  ],
  "fx": {"dtime": "1/4", "dfdbk": 50, "dcolor": 44, "dmix": 84, "rsize": 100, "rdamp": 58, "crate": 30, "cdepth": 40,
         "duck": 22},
  "patterns": {
    "st_dub": {"track": "stab", "steps": ". . c1 . . . c1_ . . . c1 . . . . ."},
    "st_hold": {"track": "stab", "div": "1/4", "steps": "c1 - . . c1_ . . ."},
    "bs_roll": {"track": "bass", "steps": ". 1 1 1_ . 1 1' 1_ . 1 1 1_ . 1 1' 2_"},
    "bs_gallop": {"track": "bass", "steps": "1_ 1 1 1 1'_ 1 1 1 1_ 1 1 1 1'_ 1 1 2"},
    "bs_follow": {"track": "bass", "steps": ". c1 c1 c1_ . c1 c1' c1_ . c1 c1 c1_ . c1 c1' c5_"},
    "bs_pulse": {"track": "bass", "div": "1/8", "steps": "1 - . 1 . . 1' ."},
    "dr_techno": {"track": "drums", "lanes": {
      "kick":  "x...x...x...x...",
      "clap":  "....x.......x...",
      "hat":   "xgsgxgsgxgsgxgsg",
      "open":  "..x...x...x...x.",
      "rim":   "......g..g....g."}},
    "dr_ride": {"track": "drums", "lanes": {
      "kick":  "x...x...x...x...",
      "clap":  "....x.......x...",
      "hat":   "xgsgxgsgxgsgxgsg",
      "ride":  "..x...x...x...x.",
      "rim":   "......g..g....g."}},
    "dr_fill": {"track": "drums", "lanes": {
      "kick":  "x...x...x...x...",
      "clap":  "....x...x.x.x.x4",
      "snare": "............s.s.",
      "hat":   "xgsgxgsgxgsg...."}}
  },
  "progressions": {
    "signal": ["i:4"],
    "line": ["i:12", "vii:4"],
    "rise": ["iv:4", "vii:4"],
    "under": ["iv:8", "i:8"]
  },
  "scenes": {
    "A": {"name": "PLATFORM", "role": "intro", "progression": "signal", "energy": "e_sig",
          "patterns": {"stab": "st_hold", "bass": "bs_pulse", "drums": "dr_techno"}},
    "B": {"name": "NIGHT LINE", "role": "main", "progression": "line", "energy": "e_line", "fill": "dr_fill",
