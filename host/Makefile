# Host programs on the real firmware (host/core.c + host/hal_host.h), built with the host tests' flags:
#   make -C host            build/host-bin/sloop-render, build/host-bin/sloop-examples
#   make -C host clean
# build/gen (tables, samples, fonts, icons, kits, logo) is made with tools/build.py --gen-only when it is
# missing; after a change to a generator or its assets, run that again. No toolchain or Docker needed.
ROOT := ..
BIN := $(ROOT)/build/host-bin
OBJ := $(ROOT)/build/host-obj
GEN := $(ROOT)/build/gen
CC ?= cc
CFLAGS := -O2
CPPFLAGS := -I. -I$(OBJ) -I$(GEN) -I$(ROOT)/firmware/src -I$(ROOT)/firmware/hal
FIRMWARE := $(wildcard $(ROOT)/firmware/src/*.c $(ROOT)/firmware/src/*.h $(ROOT)/firmware/hal/*.h)
CORE := core.c hal_host.h host.h $(OBJ)/fw_main.h $(FIRMWARE) $(GEN)/felucca_tables.h $(wildcard $(GEN)/*.h)

all: $(BIN)/sloop-render $(BIN)/sloop-examples

$(GEN)/felucca_tables.h:
	cd $(ROOT) && python3 tools/build.py --gen-only

# felucca_init() from main.c, verbatim (main.c itself is hardware: boot, ISRs, the loop)
$(OBJ)/fw_main.h: $(ROOT)/firmware/src/main.c Makefile
	@mkdir -p $(OBJ)
	@{ echo "/* generated by host/Makefile: felucca_init() from firmware/src/main.c, verbatim */"; \
	  awk '/^static void felucca_init\(void\)/,/^}/' $<; } > $@.tmp
	@grep -q 'autosave_resume();' $@.tmp && grep -q 'layers_init();' $@.tmp && grep -q '^}' $@.tmp || \
	  { echo "host/Makefile: cannot extract felucca_init() from firmware/src/main.c"; rm -f $@.tmp; exit 1; }
	@mv $@.tmp $@

# the firmware is compiled with -w, as in tests/run_tests.sh; the programs themselves with warnings
$(OBJ)/core.o: $(CORE)
	@mkdir -p $(OBJ)
	$(CC) $(CFLAGS) -w $(CPPFLAGS) -c -o $@ core.c

$(BIN)/sloop-render: render.c host.h $(OBJ)/core.o
	@mkdir -p $(BIN)
	$(CC) $(CFLAGS) -Wall -Wextra -o $@ render.c $(OBJ)/core.o -lm

# examples.c builds its projects with the firmware's own calls: it includes core.c
$(BIN)/sloop-examples: examples.c $(CORE)
	@mkdir -p $(BIN)
	$(CC) $(CFLAGS) -w $(CPPFLAGS) -o $@ examples.c -lm

clean:
	rm -rf $(BIN) $(OBJ)

.PHONY: all clean
